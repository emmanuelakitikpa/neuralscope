---
const siteName = "NeuralScope";
const tagline = "Understand AI. Choose Better. Work Smarter.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteName} | AI Tools & Software</title>
    <meta name="description" content="Independent reviews, comparisons and guides to help you choose the right AI tools." />
  </head>
  <body>
    <main>
      <h1>{siteName}</h1>
      <p>{tagline}</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    background: #101B33;
    color: #FFFFFF;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  h1 {
    font-size: 3rem;
    margin: 0 0 0.5rem;
  }
  p {
    color: #3988F5;
    font-size: 1.2rem;
    margin: 0;
  }
</style>