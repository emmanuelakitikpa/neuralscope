---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pages, ui, categorySlugs } from '../../i18n/ui';
import { legalContent } from '../../content/legal';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return pages.map((p) => ({ params: { slug: p.fr }, props: { pageKey: p.key } }));
}

const { pageKey } = Astro.props;
const text = ui.fr.pagesText[pageKey] || { title: pageKey, text: "Bientôt disponible." };
const legal = legalContent.fr[pageKey] ?? null;

// Si la page est une catégorie, on récupère les articles correspondants
const isCategory = Object.keys(categorySlugs).includes(pageKey);
let articles = [];
if (isCategory) {
  articles = (await getCollection('articles', ({ data }) => 
    data.lang === 'fr' && !data.draft && data.category === pageKey
  )).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="fr" title={text.title} description={text.text} pageKey={pageKey}>
  <article class="container page">
    <h1>{text.title}</h1>
    
    {legal ? (
      <>
        <p class="lead">{legal.intro}</p>
        <p class="updated">Dernière mise à jour : {legal.updated}</p>
        {legal.sections.map((section) => (
          <section class="legal-section">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
      </>
    ) : (
      <>
        <p class="lead">{text.text}</p>
        
        {isCategory && articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map((article) => (
              <article class="card">
                <p class="card-meta">{article.data.type.replace('-', ' ')} · {article.data.pubDate.toLocaleDateString('fr-FR', { dateStyle: 'medium' })}</p>
                <h2><a href={`${base}/fr/articles/${article.data.slug}/`}>{article.data.title}</a></h2>
                <p class="card-desc">{article.data.description}</p>
                <a class="read-link" href={`${base}/fr/articles/${article.data.slug}/`}>Lire l'article →</a>
              </article>
            ))}
          </div>
        ) : (
          <p class="muted">{ui.fr.soon}</p>
        )}
      </>
    )}
  </article>
</BaseLayout>

<style>
  .page { padding: 4rem 0 2rem; max-width: 900px; }
  .page h1 { color: var(--navy); font-size: 2.2rem; line-height: 1.2; margin: 0 0 1rem; }
  .lead { font-size: 1.15rem; color: var(--text); line-height: 1.8; }
  .updated { color: var(--muted); font-size: .9rem; margin: 1.5rem 0 2.5rem; }
  .legal-section { margin: 2rem 0; }
  .legal-section h2 { color: var(--navy); font-size: 1.35rem; margin-bottom: .65rem; }
  .legal-section p { line-height: 1.8; margin: .6rem 0; }
  
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 3rem; }
  .card { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; transition: transform 0.2s; }
  .card:hover { transform: translateY(-3px); }
  .card-meta { font-size: 11px; text-transform: uppercase; color: var(--blue); font-weight: 700; margin-bottom: 0.8rem; }
  .card h2 { font-size: 1.4rem; line-height: 1.3; margin: 0 0 1rem; }
  .card h2 a { color: var(--navy); text-decoration: none; }
  .card h2 a:hover { color: var(--blue); }
  .card-desc { color: var(--muted); line-height: 1.6; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .read-link { font-weight: bold; color: var(--navy); text-decoration: none; font-size: 0.95rem; }
  
  @media (max-width: 640px) {
    .page { padding-top: 2.5rem; }
    .page h1 { font-size: 1.8rem; }
  }
</style>