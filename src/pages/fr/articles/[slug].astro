---
import { getCollection, render } from 'astro:content';
import AdSlot from '../../../components/AdSlot.astro';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  const enArticles = all.filter((a) => a.data.lang === 'en');
  const frArticles = all.filter((a) => a.data.lang === 'fr');

  return frArticles.map((post) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      translation:
        enArticles.find((e) => e.data.translationKey === post.data.translationKey) ?? null,
    },
  }));
}

const { post, translation } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/fr/articles/${post.data.slug}/`, Astro.site);
const enUrl = translation
  ? new URL(`${base}/en/articles/${translation.data.slug}/`, Astro.site)
  : null;
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{post.data.title} | NeuralScope</title>
  <meta name="description" content={post.data.description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index,follow" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="NeuralScope" />
  <meta property="og:title" content={post.data.title} />
  <meta property="og:description" content={post.data.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
  {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
  <meta name="twitter:card" content="summary" />
  <link rel="alternate" hreflang="fr" href={canonical} />
  {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
  <link rel="alternate" hreflang="x-default" href={enUrl ?? canonical} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "inLanguage": "fr",
    "author": {
      "@type": "Person",
      "name": post.data.author
    },
    "publisher": {
      "@type": "Organization",
      "name": "NeuralScope",
      "logo": {
        "@type": "ImageObject",
        "url": new URL(`${base}/favicon.svg`, Astro.site).toString()
      }
    },
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "mainEntityOfPage": canonical.toString(),
    "keywords": post.data.tags.join(', '),
    "isPartOf": {
      "@type": "WebSite",
      "name": "NeuralScope",
      "url": Astro.site?.toString()
    },
    ...(post.data.cover ? { "image": new URL(post.data.cover, Astro.site).toString() } : {}),
    ...(enUrl ? { "sameAs": enUrl.toString() } : {})
  })} />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" translate="no" href={`${base}/fr/`}>Neural<span>Scope</span></a>
      <nav>
        <a href={`${base}/fr/articles/`}>Tous les articles</a>
        <a href={`${base}/en/articles/`} hreflang="en" lang="en">English</a>
      </nav>
    </div>
  </header>
  <main class="container">
    <a class="back" href={`${base}/fr/articles/`}>← Tous les articles</a>
    <p class="meta">
      {post.data.category.replace('-', ' ')} · {post.data.type} ·
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString('fr-FR', { dateStyle: 'long' })}
      </time>
    </p>
    <h1>{post.data.title}</h1>
    <p class="description">{post.data.description}</p>
    <p class="author">Par {post.data.author}</p>
    {enUrl && (
      <p class="translation">
        Lire cet article en <a href={enUrl} hreflang="en" lang="en">English</a>
      </p>
    )}
    <AdSlot slot="1111111111" format="horizontal" lang="fr" />
    <article class="content"><Content class="prose" /></article>
    <AdSlot slot="2222222222" format="rectangle" lang="fr" />
    {post.data.tags.length > 0 && (
      <p class="tags">Thèmes : {post.data.tags.join(' · ')}</p>
    )}
  </main>
  <footer class="site-footer">
    <div class="container">© {new Date().getFullYear()} NeuralScope. Comprendre l'IA. Mieux choisir. Travailler plus intelligemment.</div>
  </footer>
</body>
</html>

<style>
  :root {
    --navy: #101b33;
    --blue: #3988f5;
    --white: #ffffff;
    --gray: #f3f5f9;
    --text: #1d2740;
    --muted: #5d6b86;
    --border: #e4e9f1;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif; /* Police Serif pour le côté "papier" */
    background: var(--white); /* Fond blanc pur */
    color: var(--text);
    line-height: 1.7;
  }
  a { color: #2876e8; text-decoration: none; }
  a:hover { text-decoration: underline; }
  
  /* Le conteneur principal devient une colonne de lecture */
  .container { max-width: 760px; margin: 0 auto; padding: 0 24px; }
  
  /* Header et Footer gardent leur style pro */
  .site-header { background: var(--navy); color: var(--white); font-family: system-ui, -apple-system, sans-serif; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; height: 76px; max-width: 1100px; margin: 0 auto; }
  .brand { color: var(--white); font-size: 23px; font-weight: 800; }
  .brand span { color: var(--blue); }
  .site-header nav { display: flex; gap: 22px; font-size: 14px; }
  .site-header nav a { color: var(--white); }
  .site-footer { background: var(--navy); color: #cbd4e4; padding: 2.5rem 0; font-size: 13px; text-align: center; font-family: system-ui, -apple-system, sans-serif; margin-top: 5rem; }

  /* --- MISE EN PAGE ÉDITORIALE --- */
  main { padding: 4rem 24px 0; }
  
  .back { 
    font-family: system-ui, -apple-system, sans-serif; 
    font-size: 13px; 
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .meta {
    font-family: system-ui, -apple-system, sans-serif;
    margin-top: 2rem;
    color: var(--blue);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
  }
  
  h1 { 
    font-size: clamp(2.5rem, 5vw, 3.5rem); 
    line-height: 1.15; 
    margin: 1rem 0; 
    color: var(--navy); 
    font-weight: 700;
  }
  
  .description { 
    font-size: 1.4rem; 
    line-height: 1.5;
    color: var(--muted); 
    margin-bottom: 2rem;
  }
  
  .author { 
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem; 
    color: var(--navy);
    font-weight: 600;
  }
  
  .translation {
    font-family: system-ui, -apple-system, sans-serif;
    display: inline-block;
    margin: 1.5rem 0 3rem;
    padding: .6rem 1rem;
    background: #f0f5ff;
    border-left: 3px solid var(--blue);
    font-size: .9rem;
  }

  /* Le contenu de l'article (Markdown) */
  .content {
    font-size: 1.25rem; /* Texte plus grand pour la lecture */
    line-height: 1.8;
    color: #1a2235;
  }
  
  .content :global(h1) { display: none; }
  
  .content :global(h2) { 
    font-family: system-ui, -apple-system, sans-serif;
    margin-top: 3.5rem; 
    margin-bottom: 1rem;
    font-size: 1.8rem; 
    color: var(--navy); 
    line-height: 1.3;
  }
  
  .content :global(h3) { 
    font-family: system-ui, -apple-system, sans-serif;
    margin-top: 2.5rem; 
    margin-bottom: 0.8rem;
    font-size: 1.4rem; 
    color: var(--navy);
  }
  
  .content :global(p) { margin-bottom: 1.8rem; }
  .content :global(li) { margin-bottom: 0.5rem; }
  .content :global(ul), .content :global(ol) { margin-bottom: 1.8rem; padding-left: 1.5rem; }
  
  .content :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 4px solid var(--blue);
    font-style: italic;
    color: var(--muted);
  }

  .tags { 
    font-family: system-ui, -apple-system, sans-serif;
    margin-top: 4rem; 
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted); 
    font-size: .9rem; 
  }
  
  @media (max-width: 600px) {
    .site-header nav { gap: 12px; }
    main { padding-top: 2rem; }
    h1 { font-size: 2.2rem; }
    .content { font-size: 1.15rem; }
  }
  
  @media (max-width: 600px) {
    .article-body :global(table) {
      font-size: 0.85rem;
    }
    .article-body :global(th), .article-body :global(td) {
      padding: 0.6rem;
    }
  }

  @media (max-width: 600px) {
    .prose :global(table) {
      font-size: 0.85rem;
    }
    .prose :global(th), .prose :global(td) {
      padding: 0.6rem;
    }
  }
  /* TABLES-START */
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    max-width: 100%;
    width: 100%;
    border-collapse: collapse;
    margin: 2.5rem 0;
    font-size: 0.95rem;
    font-family: system-ui, -apple-system, sans-serif;
    background: white;
    border: 1px solid #e4e9f1;
  }
  .prose :global(thead) {
    background: #f8f9fc;
    border-bottom: 2px solid #e4e9f1;
  }
  .prose :global(th) {
    padding: 1rem;
    text-align: left;
    font-weight: 700;
    color: var(--navy, #101B33);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .prose :global(td) {
    padding: 1rem;
    border-bottom: 1px solid #e4e9f1;
    color: #344158;
    vertical-align: middle;
  }
  .prose :global(tr:last-child td) {
    border-bottom: none;
  }
  .prose :global(tbody tr:hover) {
    background: #f8fbff;
  }
  @media (max-width: 600px) {
    .prose :global(table) {
      font-size: 0.85rem;
    }
    .prose :global(th), .prose :global(td) {
      padding: 0.6rem;
    }
  }
  /* TABLES-END */
</style>