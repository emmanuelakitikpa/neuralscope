---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) =>
  data.lang === 'fr' && !data.draft
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout lang="fr" title="Guides et articles sur l'IA" description="Découvrez des guides pratiques, des comparatifs, des tests et des tutoriels pour mieux comprendre les outils d'intelligence artificielle." pageKey="articles">
  <main class="container">
    <header class="page-header">
      <p class="eyebrow">EXPLOREZ L'INTELLIGENCE ARTIFICIELLE</p>
      <h1>Guides et articles sur l'IA</h1>
      <p class="intro">Des guides pratiques, des analyses et des conseils pour comprendre l'intelligence artificielle et choisir les bons outils.</p>
    </header>

    {articles.length > 0 ? (
      <section class="articles-grid">
        {articles.map((article) => (
          <article class="card">
            <p class="card-meta">{article.data.type.replace('-', ' ')} · {article.data.pubDate.toLocaleDateString('fr-FR', { dateStyle: 'medium' })}</p>
            <h2><a href={`${base}/fr/articles/${article.data.slug}/`}>{article.data.title}</a></h2>
            <p class="card-desc">{article.data.description}</p>
            <a class="read-link" href={`${base}/fr/articles/${article.data.slug}/`}>Lire l'article →</a>
          </article>
        ))}
      </section>
    ) : (
      <p class="empty">Aucun article publié pour le moment. Revenez bientôt.</p>
    )}
  </main>
</BaseLayout>

<style>
  main { padding-top: 4rem; padding-bottom: 5rem; }
  .page-header { margin-bottom: 3rem; text-align: center; }
  .eyebrow { color: var(--blue); font-weight: bold; letter-spacing: 2px; font-size: 12px; text-transform: uppercase; margin-bottom: 1rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 0 0 1rem; color: var(--navy); }
  .intro { font-size: 1.2rem; line-height: 1.6; color: var(--muted); max-width: 650px; margin: 0 auto; }
  
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 3rem; }
  .card { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
  .card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
  .card-meta { font-size: 11px; text-transform: uppercase; color: var(--blue); font-weight: 700; margin-bottom: 0.8rem; }
  .card h2 { font-size: 1.4rem; line-height: 1.3; margin: 0 0 1rem; }
  .card h2 a { color: var(--navy); text-decoration: none; }
  .card h2 a:hover { color: var(--blue); }
  .card-desc { color: var(--muted); line-height: 1.6; font-size: 0.95rem; flex-grow: 1; margin-bottom: 1.5rem; }
  .read-link { font-weight: bold; color: var(--navy); text-decoration: none; font-size: 0.95rem; }
  .read-link:hover { color: var(--blue); }
  .empty { text-align: center; color: var(--muted); font-size: 1.1rem; padding: 4rem 0; }
</style>