---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Page not found" description="The page you are looking for does not exist.">
  <section class="container not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead">Sorry, the page you are looking for doesn't exist or has been moved.</p>
    <p class="lead-fr">Désolé, la page que vous recherchez n'existe pas ou a été déplacée.</p>
    <div class="actions">
      <a href="/neuralscope/en/" class="btn">Go to homepage (EN)</a>
      <a href="/neuralscope/fr/" class="btn">Retour à l'accueil (FR)</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 0;
    text-align: center;
    max-width: 700px;
  }
  .eyebrow {
    font-size: 4rem;
    font-weight: 800;
    color: var(--blue);
    margin: 0;
    line-height: 1;
  }
  h1 {
    font-size: 2.5rem;
    color: var(--navy);
    margin: 1rem 0;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .lead-fr {
    font-size: 1.1rem;
    color: var(--muted);
    font-style: italic;
    margin-bottom: 2.5rem;
  }
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.9rem 1.8rem;
    background: var(--navy);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .btn:hover {
    background: var(--blue);
  }
</style>