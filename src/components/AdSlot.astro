---
// Emplacement publicitaire AdSense réutilisable
// Affiche un placeholder tant que l'ID AdSense n'est pas configuré
// Respecte le consentement RGPD (chargé uniquement si "accepted")

interface Props {
  slot?: string;
  format?: 'auto' | 'horizontal' | 'rectangle' | 'vertical';
  lang?: 'en' | 'fr';
}

const { slot = '0000000000', format = 'auto', lang = 'fr' } = Astro.props;

// ⚠️ À REMPLACER quand ton compte AdSense sera validé :
//    Exemple : 'ca-pub-1234567890123456'
const clientId = 'ca-pub-XXXXXXXXXXXXXXXX';
const isLive = !clientId.includes('XXXXXXXXXXXXXXXX');
---

<div class="ad-slot" data-ad-format={format}>
  {isLive ? (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive="true"></ins>
  ) : (
    <div class="ad-placeholder" aria-label={lang === 'fr' ? 'Espace publicitaire' : 'Advertising space'}>
      <span class="ad-label">{lang === 'fr' ? 'PUBLICITÉ' : 'ADVERTISEMENT'}</span>
      <span class="ad-info">{lang === 'fr' ? 'Espace réservé' : 'Reserved space'}</span>
    </div>
  )}
</div>

<style>
  .ad-slot {
    margin: 2.5rem 0;
    min-height: 100px;
    max-width: 100%;
  }
  .ad-placeholder {
    min-height: 100px;
    background: #f8f9fc;
    border: 1px dashed #d1d9e6;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .ad-label {
    font-size: 10px;
    color: #999;
    letter-spacing: 1.5px;
    font-weight: 600;
  }
  .ad-info {
    font-size: 0.8rem;
    color: #bbb;
  }
</style>