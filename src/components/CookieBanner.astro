---
// Bannière de consentement RGPD pour NeuralScope
// Stocke le choix dans localStorage : "accepted" | "rejected"
// Dispatch un CustomEvent "cookie-consent" pour que les scripts réagissent
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  hidden
>
  <div class="cookie-inner">
    <div class="cookie-text">
      <h2 id="cookie-title">🍪 Votre vie privée</h2>
      <p id="cookie-desc">
        Nous utilisons des cookies pour mesurer notre audience et afficher des publicités adaptées à vos centres d''intérêt. Vous pouvez accepter ou refuser. Votre choix sera conservé sur cet appareil.
        <br>
        <a href="/neuralscope/en/privacy-policy/" class="cookie-link">Learn more</a>
        ·
        <a href="/neuralscope/fr/politique-de-confidentialite/" class="cookie-link">En savoir plus</a>
      </p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-reject" class="cookie-btn cookie-btn-secondary" type="button">
        Refuser
      </button>
      <button id="cookie-accept" class="cookie-btn cookie-btn-primary" type="button">
        Accepter
      </button>
    </div>
  </div>
</div>

<script>
  (() => {
    const STORAGE_KEY = 'neuralscope_consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');

    if (!banner || !acceptBtn || !rejectBtn) return;

    const current = localStorage.getItem(STORAGE_KEY);

    if (!current) {
      banner.hidden = false;
      document.body.classList.add('cookie-visible');
    }

    function setConsent(value: 'accepted' | 'rejected') {
      localStorage.setItem(STORAGE_KEY, value);
      banner.hidden = true;
      document.body.classList.remove('cookie-visible');
      window.dispatchEvent(
        new CustomEvent('cookie-consent', { detail: { consent: value } })
      );
    }

    acceptBtn.addEventListener('click', () => setConsent('accepted'));
    rejectBtn.addEventListener('click', () => setConsent('rejected'));
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    border-top: 3px solid #3988f5;
    box-shadow: 0 -4px 24px rgba(16, 27, 51, 0.15);
    z-index: 9999;
    padding: 1.25rem 1.5rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .cookie-text {
    flex: 1;
    min-width: 260px;
  }
  .cookie-text h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: #101b33;
  }
  .cookie-text p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #5d6b86;
  }
  .cookie-link {
    color: #2876e8;
    text-decoration: underline;
  }
  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .cookie-btn {
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    font-family: inherit;
  }
  .cookie-btn-primary {
    background: #101b33;
    color: #ffffff;
  }
  .cookie-btn-primary:hover {
    background: #3988f5;
  }
  .cookie-btn-secondary {
    background: transparent;
    color: #5d6b86;
    border: 1px solid #d1d9e6;
  }
  .cookie-btn-secondary:hover {
    background: #f3f5f9;
    color: #101b33;
  }
  @media (max-width: 640px) {
    .cookie-inner {
      flex-direction: column;
      align-items: stretch;
    }
    .cookie-actions {
      width: 100%;
    }
    .cookie-btn {
      flex: 1;
    }
  }
  /* Ajoute un padding-bottom au body quand la bannière est visible */
  :global(body.cookie-visible) {
    padding-bottom: 120px;
  }
</style>