---
import { ui, type Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Récupération des 3 derniers articles publiés dans cette langue
const latestArticles = (await getCollection('articles', ({ data }) => 
  data.lang === lang && !data.draft
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<section class="hero">
  <div class="container">
    <h1>{t.hero.title}</h1>
    <p>{t.hero.text}</p>
    <div class="search-box">
      <input type="text" placeholder={t.hero.search} />
      <button>{t.hero.button}</button>
    </div>
  </div>
</section>

<section class="categories">
  <div class="container">
    <h2>{t.categoriesTitle}</h2>
    <div class="categories-grid">
      {t.categories.map((cat) => (
        <div class="category-card">
          <h3>{cat.name}</h3>
          <p>{cat.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="popular">
  <div class="container">
    <h2>{t.popularTitle}</h2>
    <div class="popular-grid">
      {t.popular.map((tool) => (
        <div class="tool-card">
          <span class="tag">{tool.tag}</span>
          <h3>{tool.name}</h3>
          <p>{tool.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION DYNAMIQUE : Derniers articles -->
<section class="latest">
  <div class="container">
    <h2>{t.latestTitle}</h2>
    <div class="latest-grid">
      {latestArticles.map((article) => (
        <a href={`${base}/${lang}/articles/${article.data.slug}/`} class="article-card">
          <span class="tag">{article.data.category}</span>
          <h3>{article.data.title}</h3>
          <p>{article.data.description}</p>
          <span class="read-more">
            {lang === 'fr' ? 'Lire l\'article →' : 'Read article →'}
          </span>
        </a>
      ))}
    </div>
    {latestArticles.length === 0 && (
      <p class="empty">Aucun article publié pour le moment.</p>
    )}
  </div>
</section>

<style>
  .hero { padding: 5rem 0; text-align: center; background: var(--gray); }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); color: var(--navy); margin-bottom: 1rem; }
  .hero p { font-size: 1.25rem; color: var(--muted); max-width: 700px; margin: 0 auto 2.5rem; }
  .search-box { display: flex; max-width: 600px; margin: 0 auto; gap: 0.5rem; }
  .search-box input { flex: 1; padding: 0.9rem 1.2rem; border: 1px solid #d1d9e6; border-radius: 8px; font-size: 1rem; }
  .search-box button { padding: 0.9rem 2rem; background: var(--blue); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; }

  .categories { padding: 4rem 0; }
  .categories h2, .popular h2, .latest h2 { font-size: 1.8rem; color: var(--navy); margin-bottom: 2rem; text-align: center; }
  .categories-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; }
  .category-card { background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); }
  .category-card h3 { color: var(--navy); margin-bottom: 0.5rem; }
  .category-card p { color: var(--muted); font-size: 0.95rem; }

  .popular { padding: 4rem 0; background: var(--gray); }
  .popular-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; }
  .tool-card { background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); }
  .tag { display: inline-block; background: #e6efff; color: var(--blue); font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 4px; margin-bottom: 0.8rem; text-transform: uppercase; }
  .tool-card h3 { color: var(--navy); margin-bottom: 0.5rem; }
  .tool-card p { color: var(--muted); font-size: 0.9rem; }

  .latest { padding: 4rem 0; }
  .latest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
  .article-card { display: block; background: white; padding: 2rem; border-radius: 12px; border: 1px solid var(--border); text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .article-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
  .article-card h3 { color: var(--navy); margin-bottom: 0.8rem; font-size: 1.3rem; line-height: 1.3; }
  .article-card p { color: var(--muted); font-size: 0.95rem; margin-bottom: 1.5rem; }
  .read-more { color: var(--blue); font-weight: 600; font-size: 0.9rem; }
  .empty { text-align: center; color: var(--muted); font-style: italic; }
</style>