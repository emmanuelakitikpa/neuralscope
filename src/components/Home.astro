---
import { ui, type Lang } from '../i18n/ui';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const latestArticles = (await getCollection('articles', ({ data }) => 
  data.lang === lang && !data.draft
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<!-- SECTION HERO (Design MetaLeaf) -->
<section class="hero" style={`background-image: linear-gradient(to right, rgba(16, 27, 51, 0.95) 0%, rgba(16, 27, 51, 0.85) 40%, rgba(16, 27, 51, 0.4) 100%), url('${base}/images/hero-bg.png');`}>
  <div class="container hero-content">
    <h1>{t.hero.title}</h1>
    <p>{t.hero.text}</p>
    <div class="search-box">
      <input type="text" placeholder={t.hero.search} />
      <button>{t.hero.button}</button>
    </div>
  </div>
</section>

<!-- SECTION CATEGORIES -->
<section class="section bg-light">
  <div class="container">
    <h2>{t.categoriesTitle}</h2>
    <div class="grid">
      {t.categories.map((cat) => (
        <div class="card category-card">
          <h3>{cat.name}</h3>
          <p>{cat.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION OUTILS POPULAIRES -->
<section class="section">
  <div class="container">
    <h2>{t.popularTitle}</h2>
    <div class="grid">
      {t.popular.map((tool) => (
        <div class="card tool-card">
          <span class="tag">{tool.tag}</span>
          <h3>{tool.name}</h3>
          <p>{tool.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION DERNIERS ARTICLES -->
<section class="section bg-light">
  <div class="container">
    <h2>{t.latestTitle}</h2>
    <div class="grid">
      {latestArticles.map((article) => (
        <a href={`${base}/${lang}/articles/${article.data.slug}/`} class="card article-card">
          <span class="tag">{article.data.category}</span>
          <h3>{article.data.title}</h3>
          <p>{article.data.description}</p>
          <span class="read-more">
            {lang === 'fr' ? 'Lire l\'article →' : 'Read article →'}
          </span>
        </a>
      ))}
    </div>
    {latestArticles.length === 0 && (
      <p class="empty">Aucun article publié pour le moment.</p>
    )}
  </div>
</section>

<style>
  /* Hero Section */
  .hero {
    padding: 10rem 0 8rem;
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
    color: white;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .hero-content { max-width: 650px; }
  .hero h1 { 
    font-size: clamp(3rem, 6vw, 4.5rem); 
    margin-bottom: 1.5rem; 
    line-height: 1.1; 
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .hero p { 
    font-size: 1.25rem; 
    color: #a9b6d1; 
    margin-bottom: 3rem; 
    line-height: 1.6;
    max-width: 90%;
  }
  
  /* Search Box (Glassmorphism) */
  .search-box { display: flex; gap: 10px; }
  .search-box input { 
    flex: 1; 
    padding: 1.2rem 1.5rem; 
    border: 1px solid rgba(255,255,255,0.2); 
    border-radius: 8px; 
    font-size: 1rem; 
    outline: none; 
    background: rgba(255,255,255,0.1); 
    color: white;
    backdrop-filter: blur(10px);
  }
  .search-box input::placeholder { color: #a9b6d1; }
  .search-box input:focus { border-color: #3988f5; background: rgba(255,255,255,0.15); }
  .search-box button { 
    padding: 0 2.5rem; 
    background: #3988f5; 
    color: white; 
    border: none; 
    border-radius: 8px; 
    font-weight: 600; 
    cursor: pointer; 
    font-size: 1rem;
    transition: background 0.2s;
  }
  .search-box button:hover { background: #2876e8; }

  /* Sections communes */
  .section { padding: 6rem 0; }
  .bg-light { background: #f8f9fc; }
  h2 { font-size: 2.2rem; color: #101b33; margin-bottom: 3rem; text-align: center; font-weight: 800; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
  
  /* Cartes */
  .card { 
    background: #ffffff; 
    padding: 2.5rem 2rem; 
    border-radius: 16px; 
    border: 1px solid #e4e9f1; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.03); 
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
  
  .category-card h3 { color: #101b33; margin: 0 0 1rem; font-size: 1.4rem; font-weight: 700; }
  .category-card p { color: #5d6b86; font-size: 1rem; line-height: 1.6; margin: 0; }
  
  .tool-card { text-align: center; }
  .tool-card h3 { color: #101b33; margin: 1rem 0 0.5rem; font-size: 1.3rem; }
  .tool-card p { color: #5d6b86; font-size: 0.95rem; margin: 0; }
  
  .article-card { text-decoration: none; display: flex; flex-direction: column; }
  .article-card h3 { color: #101b33; margin: 0 0 1rem; font-size: 1.4rem; line-height: 1.4; font-weight: 700; }
  .article-card p { color: #5d6b86; font-size: 0.95rem; line-height: 1.6; margin: 0 0 1.5rem; flex-grow: 1; }
  
  .tag { 
    display: inline-block; 
    background: #e6efff; 
    color: #3988f5; 
    font-size: 0.75rem; 
    font-weight: 700; 
    padding: 0.4rem 0.8rem; 
    border-radius: 20px; 
    margin-bottom: 1.2rem; 
    text-transform: uppercase; 
    letter-spacing: 0.5px; 
    align-self: flex-start;
  }
  .read-more { color: #3988f5; font-weight: 700; font-size: 0.95rem; }
  .empty { text-align: center; color: #5d6b86; font-style: italic; }
  
  /* Responsive */
  @media (max-width: 768px) {
    .hero { padding: 6rem 0; background-position: center; }
    .hero h1 { font-size: 2.5rem; }
    .search-box { flex-direction: column; }
    .search-box button { padding: 1rem; }
  }
</style>